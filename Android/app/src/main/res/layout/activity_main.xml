<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WokTok"
            android:textColor="#58A6FF"
            android:textSize="42sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speak any Indian language"
            android:textColor="#8B949E"
            android:textSize="14sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="English Text"
            android:textColor="#C9D1D9"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etText"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="#161B22"
            android:hint="Type something in English..."
            android:textColor="#C9D1D9"
            android:textColorHint="#484F58"
            android:gravity="top"
            android:padding="12dp"
            android:inputType="textMultiLine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Target Language"
            android:textColor="#C9D1D9"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerLang"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="#161B22" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Voice Style"
            android:textColor="#C9D1D9"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerVoice"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="#161B22" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:text="Hold to Speak English"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#0D1117"
            android:backgroundTint="#3FB950" />

        <Button
            android:id="@+id/btnSpeak"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="Speak"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0D1117"
            android:backgroundTint="#58A6FF" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Stop"
            android:textColor="#FFFFFF"
            android:backgroundTint="#30363D" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ready"
            android:textColor="#8B949E"
            android:textAlignment="center"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>