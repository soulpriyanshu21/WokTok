<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Logo -->
        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="WokTok"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Speak. Listen. Understand."
            android:textColor="#8B949E"
            android:textSize="14sp"
            android:layout_marginBottom="40dp" />

        <!-- Language card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#0F141C">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I SPEAK"
                    android:textColor="#58A6FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2" />

                <Spinner
                    android:id="@+id/spinnerMyLang"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="#05070D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="ROOM CODE"
                    android:textColor="#58A6FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2" />

                <EditText
                    android:id="@+id/etRoomCode"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="#05070D"
                    android:hint="e.g. PRIY"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#484F58"
                    android:padding="16dp"
                    android:inputType="textCapCharacters"
                    android:letterSpacing="0.3"
                    android:textSize="18sp"
                    android:maxLength="10" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Join button with glow -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_button_glow" />

            <Button
                android:id="@+id/btnJoinRoom"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="ENTER ROOM"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#05070D"
                android:letterSpacing="0.15"
                android:background="@drawable/bg_button_gradient"
                android:stateListAnimator="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Both phones must use the same Room Code"
            android:textColor="#484F58"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>